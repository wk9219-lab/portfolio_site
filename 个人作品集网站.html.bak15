:0;z-index:10050;background:rgba(5,5,7,.965);overflow-y:auto;padding:76px 0 96px}.wp__cvin{max-width:1040px;margin:0 auto;padding:0 24px;position:relative}.wp__cvin .wp__card--wide{aspect-ratio:16/9}.wp__cvclose{position:fixed;top:20px;right:26px;width:40px;height:40px;border-radius:50%;border:1px solid rgba(255,255,255,.22);background:rgba(12,12,16,.75);color:#fff;font-size:20px;line-height:1;cursor:pointer;z-index:10060}.wp__lb{z-index:10080}.wp__pg{display:grid;grid-template-columns:repeat(4,1fr);gap:18px}.wp__pgitem{cursor:zoom-in}.wp__pgcover{position:relative;aspect-ratio:4/3;border-radius:12px;background-size:contain;background-repeat:no-repeat;background-position:center;background-color:#111116;transition:transform .4s,box-shadow .4s}.wp__pgitem:hover .wp__pgcover{transform:translateY(-4px);box-shadow:0 20px 46px rgba(0,0,0,.55)}.wp__pgcover .wp__no{color:rgba(255,255,255,.78);text-shadow:0 4px 20px rgba(0,0,0,.75)}.wp__pv{position:fixed;inset:0;z-index:10092;background:rgba(4,4,6,.975);display:flex;align-items:center;justify-content:center}.wp__pvin{width:100%;position:relative}.wp__pvbody{display:flex;gap:22px;overflow-x:auto;overflow-y:hidden;scroll-snap-type:x mandatory;padding:0 calc(50vw - 360px);scrollbar-width:none}.wp__pvbody::-webkit-scrollbar{display:none}.wp__pvimg{flex:0 0 auto;width:auto;height:62vh;max-width:72vw;object-fit:contain;border-radius:14px;scroll-snap-align:center;cursor:pointer;background:#0f0f13}.wp__pvname{display:flex;align-items:baseline;justify-content:center;gap:12px;margin-top:22px;text-align:center}.wp__pvname b{font-weight:600;font-size:17px;letter-spacing:.12em;color:rgba(255,255,255,.92)}.wp__pvname em{font-style:normal;font-size:10px;letter-spacing:.28em;color:rgba(255,255,255,.38)}.wp__pvname i{font-style:normal;font-size:11px;letter-spacing:.1em;color:rgba(255,255,255,.45);margin-left:6px}.wp__pvn{position:fixed;top:50%;transform:translateY(-50%);width:46px;height:46px;border-radius:50%;border:1px solid rgba(255,255,255,.2);background:rgba(10,10,14,.7);color:#fff;font-size:22px;line-height:1;cursor:pointer;z-index:10100}.wp__pvn--l{left:22px}.wp__pvn--r{right:22px}.wp__pvclose{position:fixed;top:20px;right:26px;width:40px;height:40px;border-radius:50%;border:1px solid rgba(255,255,255,.22);background:rgba(12,12,16,.75);color:#fff;font-size:20px;line-height:1;cursor:pointer;z-index:10100}@media(max-width:900px){.wp__pg{grid-template-columns:repeat(2,1fr)}}@media(max-width:640px){.wp__pg{grid-template-columns:1fr}.wp__pvimg{height:48vh}}</style>
  </head>
  <body>
    <div id="root"></div>
  <script>(function(){function f(){var t=document.querySelector(".hero__title");if(!t)return false;var L=t.querySelector(".hero__line")||t,p=t.style.fontSize;t.style.fontSize="400px";var n=L.scrollWidth,a=L.clientWidth;if(!n||!a){t.style.fontSize=p;return false;}var s=400*a/n*.995;s=Math.max(16,Math.min(s,400));t.style.fontSize=s.toFixed(2)+"px";return true;}var i=0,iv=setInterval(function(){if(f()||++i>80){clearInterval(iv);}},100);window.addEventListener("resize",function(){f();});window.addEventListener("load",function(){f();});})();</script></body>
</html>
