{transform:scale(1.015)}.project__orb{width:58%;aspect-ratio:1;border-radius:50%;filter:blur(28px);opacity:.85;transition:transform .8s var(--ease)}.project:hover .project__orb{transform:scale(1.14)}.project--red .project__orb{background:radial-gradient(circle at 35% 32%,#ff5a4d,var(--red) 38%,var(--red-deep) 72%,#12060a)}.project--cyan .project__orb{background:radial-gradient(circle at 35% 32%,#4fd6c8,#1d7d78 40%,var(--cyan) 72%,#06110f)}.project--amber .project__orb{background:radial-gradient(circle at 35% 32%,#ffcf7a,#d08a2a 42%,#4a2d0a 74%,#120d05)}.project__no{position:absolute;top:22px;left:26px;font-size:clamp(32px,4vw,60px);font-weight:900;letter-spacing:-.04em;color:#ffffff1a;z-index:2}.project__body{padding:8px 0}.project__title{margin:0 0 12px;font-size:clamp(24px,2.6vw,38px);font-weight:800;letter-spacing:-.025em;line-height:1.15}.project__meta{display:block;font-size:12px;letter-spacing:.1em;color:var(--fg-faint);margin-bottom:18px}.project__desc{margin:0;font-size:15px;line-height:1.8;color:var(--fg-dim);max-width:520px}.caps{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:20px}.cap{padding:38px 32px 42px}.cap__no{display:block;font-size:12px;letter-spacing:.18em;color:var(--red);font-weight:700;margin-bottom:26px}.cap__title{margin:0 0 14px;font-size:21px;font-weight:700;letter-spacing:-.01em}.cap__desc{margin:0;font-size:14px;line-height:1.8;color:var(--fg-dim)}.contact{position:relative;min-height:100vh;display:flex;flex-direction:column;justify-content:center;overflow:hidden;padding:clamp(80px,12vh,140px) var(--pad) 0}.contact__bg{position:absolute;top:0;right:0;bottom:0;left:0;z-index:0;background:linear-gradient(180deg,var(--bg) 0%,#100608 55%,#0a0a0c 100%);overflow:hidden}.contact__blob{width:62vw;height:62vw;top:6vw;left:12vw;background:radial-gradient(circle,rgba(127,20,15,.62) 0%,rgba(255,45,31,.18) 38%,transparent 70%);opacity:.9;animation:floatA 26s ease-in-out infinite}.contact__inner{position:relative;z-index:2;max-width:var(--maxw);margin:0 auto;width:100%}.contact .section-title{margin-bottom:clamp(32px,5vh,60px)}.contact__big{margin:0 0 32px;font-size:clamp(44px,8.5vw,150px);line-height:.92;font-weight:900;letter-spacing:-.045em}.contact__accent{color:var(--red)}.contact__text{max-width:560px;font-size:clamp(15px,1.4vw,19px);line-height:1.75;color:var(--fg-dim);margin:0 0 44px}.contact__row{display:flex;align-items:center;gap:28px;flex-wrap:wrap}.contact__mail{font-size:14px;color:var(--fg-faint);letter-spacing:.04em}.footer{position:relative;z-index:2;max-width:var(--maxw);margin:clamp(60px,10vh,120px) auto 0;width:100%;padding:28px 0;border-top:1px solid var(--line);display:flex;justify-content:space-between;gap:16px;flex-wrap:wrap;font-size:12px;letter-spacing:.08em;color:var(--fg-faint)}@media (max-width: 1024px){.profile,.project{grid-template-columns:1fr}.nav__links{display:none}}@media (max-width: 640px){.hero__title{font-size:10.5vw}.section-title{gap:12px}.hero__stats{gap:22px}.hero__foot{flex-direction:column;align-items:flex-start}.footer{flex-direction:column}}@media (prefers-reduced-motion: reduce){*,*:before,*:after{animation-duration:.01ms!important;animation-iteration-count:1!important;transition-duration:.01ms!important}[data-reveal],.hero__word{opacity:1;transform:none}}.contact-item{display:inline-flex;align-items:center;gap:10px;font-size:13px;color:var(--fg-faint);text-decoration:none;letter-spacing:.02em;transition:color .3s var(--ease)}.contact-item__icon{width:17px;height:17px;flex-shrink:0;color:var(--red);opacity:.85;transition:opacity .3s var(--ease),transform .3s var(--ease)}a.contact-item:hover{color:var(--fg)}a.contact-item:hover .contact-item__icon{opacity:1;transform:translateY(-1px)}.profile__contact .contact-item{width:100%}.profile__contact .contact-item+.contact-item{margin-top:2px}.contact-item--light{color:#ffffff9e;font-size:14px}a.contact-item--light:hover{color:#fff}.contact__meta{display:flex;flex-wrap:wrap;gap:32px;margin-top:26px;padding-top:24px;border-top:1px solid var(--line);max-width:640px}.btn__icon{width:17px;height:17px;flex-shrink:0}.contact__mail{display:none}.skills{display:grid;grid-template-columns:1fr 1fr;gap:clamp(28px,4vw,64px);align-items:start}.skills__group{min-width:0}.skills__label{display:flex;align-items:center;gap:14px;margin:0 0 20px;font-size:12px;font-weight:700;letter-spacing:.2em;text-transform:uppercase;color:var(--fg-dim)}.skills__label:after{content:"";flex:1;height:1px;background:var(--line)}.skills__grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:10px}.skill{display:flex;align-items:center;gap:12px;padding:11px 13px;border-radius:12px;background:rgba(255,255,255,.025);border:1px solid var(--line);transition:transform .45s var(--ease),background .45s var(--ease),border-color .45s var(--ease)}.skill:hover{transform:translateY(-2px);background:rgba(255,255,255,.055);border-color:rgba(255,255,255,.16)}.skill__icon{width:34px;height:34px;flex:none;border-radius:9px;border:1px solid transparent;display:grid;place-items:center}.skill__icon svg{width:18px;height:18px;display:block}.skill__name{font-size:13.5px;font-weight:600;color:var(--fg);letter-spacing:.01em;white-space:nowrap}@media (max-width:1024px){.skills{grid-template-columns:1fr;gap:34px}}@media (max-width:640px){.skills__grid{grid-template-columns:1fr 1fr;gap:8px}.skill{padding:9px 10px;gap:9px}.skill__icon{width:29px;height:29px;border-radius:8px}.skill__icon svg{width:16px;height:16px}.skill__name{font-size:12px}}.wp{position:fixed;inset:0;z-index:10000;background:var(--bg);display:flex;flex-direction:column;opacity:0;visibility:hidden;transition:opacity .45s var(--ease),visibility .45s var(--ease)}.wp.is-open{opacity:1;visibility:visible}.wp__bar{flex:0 0 auto;display:flex;align-items:center;justify-content:space-between;padding:16px var(--pad);border-bottom:1px solid var(--line);background:rgba(8,8,10,.72);backdrop-filter:blur(22px)}.wp__logo{font-size:12px;font-weight:700;letter-spacing:.22em;color:var(--fg)}.wp__back{display:inline-flex;align-items:center;gap:8px;padding:9px 18px;border:1px solid rgba(255,255,255,.18);border-radius:999px;font-size:12px;letter-spacing:.08em;color:var(--fg-dim);background:transparent;cursor:pointer;font-family:inherit;transition:.3s}.wp__back:hover{color:#fff;border-color:var(--red);background:rgba(255,45,31,.12)}.wp__scroll{flex:1 1 auto;min-height:0;overflow-y:auto;overscroll-behavior:contain}.wp__inner{max-width:var(--maxw);margin:0 auto;padding:clamp(40px,7vh,88px) var(--pad) 130px}.wp__title{display:flex;align-items:baseline;gap:16px;flex-wrap:wrap;margin:0 0 clamp(26px,4vh,50px)}.wp__title b{font-size:clamp(26px,4.2vw,64px);font-weight:900;letter-spacing:-.03em;color:transparent;-webkit-text-stroke:1px rgba(255,255,255,.6)}.wp__title i{font-style:normal;font-size:clamp(18px,2.4vw,36px);font-weight:300;color:rgba(255,255,255,.28)}.wp__title span{font-size:clamp(18px,2.4vw,36px);font-weight:800;color:#fff}.wp__sec+.wp__sec{margin-top:clamp(56px,9vh,118px)}.wp__grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.wp__card{position:relative;border-radius:14px;overflow:hidden;border:1px solid var(--line)}.wp__card--wide{aspect-ratio:16/9}.wp__card--big{aspect-ratio:21/9;border-radius:18px}.wp__card--sq{aspect-ratio:1/1}.wp__no{position:absolute;right:11px;bottom:8px;font-size:11px;letter-spacing:.16em;color:rgba(255,255,255,.45)}.wp__cap{display:flex;align-items:baseline;gap:14px;margin-top:16px;flex-wrap:wrap}.wp__cap b{font-size:clamp(16px,1.6vw,22px);font-weight:800;letter-spacing:-.01em}.wp__cap span{font-size:12px;letter-spacing:.14em;color:var(--fg-faint)}@media (max-width:1024px){.wp__grid{grid-template-columns:repeat(2,1fr)}}@media (max-width:640px){.wp__grid{grid-template-columns:1fr;gap:10px}.wp__inner{padding-bottom:90px}}.contact__meta{gap:40px;border-top-color:rgba(255,255,255,.14)}.contact__meta .contact-item--light{font-size:16px;font-weight:500;color:rgba(255,255,255,.88)}.contact__meta .contact-item__icon{width:20px;height:20px}@media (max-width:640px){.contact__meta{gap:20px}.contact__meta .contact-item--light{font-size:14px}.contact__meta .contact-item__icon{width:17px;height:17px}}.profile__avatar{background:url("data:image/jpeg;base64,") center 36%/cover no-repeat;border:1px solid rgba(255,255,255,.16);box-shadow:0 18px 48px rgba(255,45,31,.26),0 0 0 3px rgba(8,8,10,.9),0 0 0 4px rgba(255,255,255,.06)}.profile__avatar span{opacity:0}.profile{align-items:end}.profile__avatar{width:160px;height:160px;margin-bottom:30px}.nav__right{display:flex;align-items:center;gap:18px}.nav__link--hot{color:#fff!important;font-weight:700;letter-spacing:.06em;padding:10px 20px;border:1px solid #ff2d1f;border-radius:999px;background:linear-gradient(135deg,#ff2d1f,#c8180d);box-shadow:0 8px 26px rgba(255,45,31,.38);transition:transform .3s,box-shadow .3s}.nav__link--hot .nav__bracket{color:rgba(255,255,255,.7)}.nav__link--hot:hover{transform:translateY(-2px);box-shadow:0 12px 34px rgba(255,45,31,.62)}.nav__link--hot:hover .nav__bracket{color:#fff}@media(max-width:1024px){.nav__link--hot{display:none}}.project__visual--photo{background-color:#0a0a0f;background-size:cover;background-position:center}.project__visual--photo .project__no{color:rgba(255,255,255,.72);text-shadow:0 4px 28px rgba(0,0,0,.7)}.wp__grid--four{grid-template-columns:repeat(4,1fr);gap:18px}.wp__item{display:flex;flex-direction:column;gap:10px}.wp__label{display:flex;align-items:baseline;gap:9px}.wp__label b{font-size:13px;font-weight:700;letter-spacing:.02em;color:rgba(255,255,255,.92)}.wp__label em{font-style:normal;font-size:9.5px;letter-spacing:.15em;color:var(--fg-faint)}.wp__card--img{background-size:cover;background-position:center;background-color:#0d0d12}.wp__card--img:before{content:"";position:absolute;inset:0;background:linear-gradient(180deg,rgba(6,6,9,.34) 0%,rgba(6,6,9,0) 30%,rgba(6,6,9,.62) 100%);pointer-events:none}.wp__card--img .wp__no{z-index:2;color:rgba(255,255,255,.82);font-weight:700}.wp__card{transition:transform .55s var(--ease),box-shadow .55s var(--ease)}.wp__card:hover{transform:translateY(-3px);box-shadow:0 22px 50px rgba(0,0,0,.55)} @media(max-width:1280px){.wp__grid--four{grid-template-columns:repeat(3,1fr)}} @media(max-width:1024px){.wp__grid--four{grid-template-columns:repeat(2,1fr)}} @media(max-width:640px){.wp__grid--four{grid-template-columns:1fr;gap:12px}}.wp__grid--video{grid-template-columns:repeat(3,1fr);gap:22px}.wp__card--video{overflow:hidden;cursor:pointer}.wp__card--video video{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;display:block;z-index:1}.wp__play{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);width:56px;height:56px;border-radius:50%;display:flex;align-items:center;justify-content:center;background:rgba(8,8,10,.5);border:1px solid rgba(255,255,255,.55);color:#fff;font-size:14px;line-height:1;z-index:3;backdrop-filter:blur(6px);transition:opacity .3s,background .3s,border-color .3s,transform .3s}.wp__card--video:hover .wp__play{background:rgba(255,45,31,.92);border-color:#ff2d1f;transform:translate(-50%,-50%) scale(1.06)}.wp__play.is-on{opacity:0}.wp__card--video:hover .wp__play.is-on{opacity:.8}.wp__dur{position:absolute;right:11px;top:10px;z-index:3;font-size:10px;letter-spacing:.06em;color:rgba(255,255,255,.88);background:rgba(8,8,10,.55);border-radius:4px;padding:2px 6px} @media(max-width:1024px){.wp__grid--video{grid-template-columns:repeat(2,1fr)}} @media(max-width:640px){.wp__grid--video{grid-template-columns:1fr;gap:14px}}</style>
  </head>
  <body>
    <div id="root"></div>
  <script>(function(){function f(){var t=document.querySelector(".hero__title");if(!t)return false;var L=t.querySelector(".hero__line")||t,p=t.style.fontSize;t.style.fontSize="400px";var n=L.scrollWidth,a=L.clientWidth;if(!n||!a){t.style.fontSize=p;return false;}var s=400*a/n*.995;s=Math.max(16,Math.min(s,400));t.style.fontSize=s.toFixed(2)+"px";return true;}var i=0,iv=setInterval(function(){if(f()||++i>80){clearInterval(iv);}},100);window.addEventListener("resize",function(){f();});window.addEventListener("load",function(){f();});})();</script></body>
</html>
